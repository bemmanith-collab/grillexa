generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Postgres in all environments (production on Fly.io, local dev via
// docker-compose or any reachable Postgres instance). DATABASE_URL is
// supplied via environment variable / Fly secret, never hardcoded.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role/type fields are plain Strings rather than Prisma enums so this
// schema stays portable; values are validated in application code.

// role: "ADMIN" | "MANAGER" | "SALES"
// SALES accounts must be assigned at least one store (enforced in the users
// route, not in the schema, so ADMIN/MANAGER can stay company-wide). Stores
// and SALES users are many-to-many — a store can have more than one sales
// person assigned (e.g. a backup covering for someone who's out) and a
// sales person can cover several stores.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  passwordHash String
  role      String   @default("SALES")

  // "Every store, including the ones that do not exist yet."
  //
  // A standing assignment rather than a snapshot. Ticking every box in the
  // picker would cover today's shops and silently miss the one opened next
  // month, which is exactly the case this is for — the account that is meant to
  // see everything. Resolved per request in middleware/auth.js, so a store
  // added an hour ago is already included.
  allStores Boolean  @default(false)

  createdAt DateTime @default(now())

  stores           Store[]
  dispatchInvoices DispatchInvoice[]
  sales            Sale[]
  returns          Return[]
  consignments     Consignment[]
  settlements      Settlement[]
  wastages         Wastage[]
  whatsappPosts    WhatsAppPost[]
  // Distinct from `stores`, which is the many-to-many "who covers this shop".
  // This is authorship: who walked up to it and put it in the system. Named
  // because two relations now join User and Store and Prisma cannot guess.
  createdStores    Store[]           @relation("StoreCreatedBy")
  createdLeads     RetailerLead[]    @relation("LeadCreatedBy")
  pushSubscriptions PushSubscription[]

  // Team chat. Four relations join User to two tables, so every one is named —
  // Prisma cannot guess which is which.
  chatMessages     TeamChatMessage[] @relation("ChatSender")
  chatDeletions    TeamChatMessage[] @relation("ChatDeletedBy")
  chatMembership   TeamChatMember?   @relation("ChatMember")
  chatAdditions    TeamChatMember[]  @relation("ChatAddedBy")
}

// One row per browser-and-device that agreed to receive notifications, not one
// per user: the same person signing in on a phone and a laptop is two
// endpoints, and both should buzz.
//
// The endpoint is the address the push service gave us and is the natural key —
// re-subscribing on the same device returns the same endpoint, so upserting on
// it is what stops duplicates accumulating every time the app is opened.
//
// Rows die on their own: a push service answers 404 or 410 once a subscription
// is dead (app uninstalled, permission revoked, browser data cleared), and the
// send path deletes them then. Nothing else prunes this table.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  auth      String
  p256dh    String
  // Nullable so a subscription is never orphaned into uselessness if the user
  // is removed — but in practice always set, since subscribing requires a session.
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // The send path asks "every subscription except this user's", never "which
  // user owns this endpoint", so the index that matters is on userId.
  @@index([userId])
}

// The Grilling Wisdom Planner: what the business wants said today, and to
// whom. Two audiences, because they are read in different places and by
// different people — STAFF lines appear on the dashboard when a salesperson
// opens the app, CUSTOMER lines print on the footer of their bill.
//
// audience: "STAFF" | "CUSTOMER"
// source:   "CURATED" (written or approved here) | "WEB" (pulled from a quote
//           API and approved by an admin — nothing reaches a customer's bill
//           without a person having said yes to it)
model WisdomMessage {
  id        Int       @id @default(autoincrement())
  text      String
  author    String    @default("The Grillexa Team")
  audience  String    @default("STAFF")
  // Pinned to one day. Null means the message is part of the rotating pool,
  // which is what most of them are — a pinned line is for the day you want to
  // say something specific.
  showOn    DateTime?
  active    Boolean   @default(true)
  source    String    @default("CURATED")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([audience, active])
}

// Every post the WhatsApp generator has written, kept so the channel can be
// looked at as a whole rather than one post at a time: what has been posted this
// week, which types are going stale, and which of them anybody actually used.
//
// `text` is stored because a post that was sent to customers should be
// recoverable — the generator is not deterministic, so regenerating it produces
// a different post, not the same one.
model WhatsAppPost {
  id         Int      @id @default(autoincrement())
  type       String
  audience   String
  language   String   @default("english")
  slot       String?
  day        String
  postDate   String   // the Indian calendar date it was written for, YYYY-MM-DD
  occasion   String?
  ingredient String?
  topic      String?
  provider   String?
  text       String
  // Generated is not the same as published. Only the ones marked used should
  // count when working out what the channel has actually shown people.
  used       Boolean  @default(false)
  // -1, 0 or 1. Deliberately blunt: a five-point scale nobody fills in is worth
  // less than a thumb that gets pressed.
  rating     Int      @default(0)
  createdAt  DateTime @default(now())
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])

  @@index([createdAt])
  @@index([type, createdAt])
}

// One row per day a reminder went out.
//
// The unique constraint is the lock. Fly runs more than one machine and both
// can be awake at once, so every machine checks the clock and they all try to
// insert — the first wins, the rest get a constraint violation and stay quiet.
// A flag in memory would send the reminder twice on a busy morning.
model WhatsAppReminder {
  id         Int      @id @default(autoincrement())
  sentFor    String   @unique // the Indian date the reminder was about, YYYY-MM-DD
  sentAt     DateTime @default(now())
  recipients Int      @default(0)
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?
  phone     String?
  // Where the store actually is, captured on the phone standing outside it.
  // The address is a label for humans; these are what a map needs. Nullable
  // because every store already in the table was added without them, and a
  // store nobody has walked to yet has no pin.
  lat       Float?
  lng       Float?
  // Radius in metres the browser reported for the fix. Kept because it is the
  // only thing that tells a 8m GNSS pin from a 5km guess off wifi — they look
  // identical once saved, and the second one silently sends drivers to the
  // wrong road. Null for a pin typed in by hand, which has no sensor estimate.
  accuracyM Float?
  // Where the pin came from: 'GPS', 'MANUAL' or 'GEOCODED'. accuracyM cannot
  // answer this — a hand-placed pin and one guessed from an address both record
  // null, because neither was measured. The difference decides whether the
  // automatic capture on billing may replace it: a machine's guess at an
  // address should be, a person's deliberate correction never. Null means the
  // row predates the column, and accuracyM decides as it always did.
  pinSource String?
  // Which sales zone the store belongs to: 'Zone 1' … 'Zone 4', or null for
  // a store nobody has placed yet. A fixed list checked by the API, not an
  // enum: renaming a zone should not need a migration.
  zone      String?
  createdAt DateTime @default(now())
  // Who added it. Nullable because every store already in the table was added
  // before anyone recorded this, and those cannot be attributed after the fact.
  // SetNull rather than Cascade: deleting a user must never delete their shops.
  createdById Int?
  createdBy   User?  @relation("StoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  salesUsers        User[]
  dailyStockEntries DailyStockEntry[]
  dispatchInvoices  DispatchInvoice[]
  sales             Sale[]
  returns           Return[]
  consignments      Consignment[]
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  sku       String   @unique
  price     Float    @default(0)
  // What it costs to stock this product — distinct from the selling price
  // above. Drives the Profit & Loss report (profit = price - costPrice).
  costPrice Float    @default(0)
  // Company-wide default reorder point; used to flag a store's closing stock as low.
  threshold Int      @default(10)
  // Where this product sits in every list — the delivery and billing pickers,
  // Today's Stock, the Products page. Alphabetical order filed "Mixed fruit
  // bowl" between "Green sprouts" and "Mixed sprouts", which is not how anyone
  // loading a van reads the list: they read it by family. Lower sorts first,
  // ties fall back to name. Numbered in tens so a new product can be slotted
  // between two others without renumbering, and a product added without a
  // number lands at the end rather than silently at the top.
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyStockEntries    DailyStockEntry[]
  dispatchInvoiceLines DispatchInvoiceLine[]
  saleLines            SaleLine[]
  returns              Return[]
  consignmentItems     ConsignmentItem[]
  wastages             Wastage[]
}

// One row per (date, store, product) — the daily stock ledger.
// closing = opening + received - sold - wastage, recomputed whenever
// a dispatch, sale, or wastage entry touches this date/store/product.
// consignmentQty is a separate running balance (like closing, not a daily
// delta like received/sold/wastage) tracking how much of the physical
// stock at this store is still on consignment — delivered but not yet
// settled. See backend/src/lib/stock.js for how it's carried forward.
model DailyStockEntry {
  id             Int      @id @default(autoincrement())
  date           DateTime
  storeId        Int
  store          Store    @relation(fields: [storeId], references: [id])
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  opening        Int      @default(0)
  received       Int      @default(0)
  sold           Int      @default(0)
  wastage        Int      @default(0)
  closing        Int      @default(0)
  consignmentQty Int      @default(0)
  // How much of `wastage` above was put there by the offline CSV import
  // (POST /api/import/offline). Wastage is an increment with no audit row of
  // its own — recompute-ledger.js rebuilds every other column from source
  // records but has to take wastage as recorded — so re-running an import
  // would otherwise add the same units a second time. Storing what the import
  // contributed lets it apply the difference instead: importing the same file
  // twice is a no-op, and importing a corrected file corrects the day.
  // Never touched by the wastage form, which stays a plain increment.
  importedWastage Int     @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([date, storeId, productId], name: "dailyEntryKey")
}

// The "bill" for stock sent from HQ to a store.
model DispatchInvoice {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  date        DateTime
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  totalAmount Float
  createdAt   DateTime @default(now())

  lines DispatchInvoiceLine[]
}

model DispatchInvoiceLine {
  id        Int             @id @default(autoincrement())
  invoiceId Int
  invoice   DispatchInvoice @relation(fields: [invoiceId], references: [id])
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  amount    Float
}

// A retail sales bill issued by a store to a customer. Customer fields are
// all optional walk-in retail sales usually have none of these — they only
// get filled in when the bill needs to double as a proper invoice (e.g. the
// customer wants their GSTIN on it for input tax credit).
model Sale {
  id            Int          @id @default(autoincrement())
  number        String       @unique
  date          DateTime
  storeId       Int
  store         Store        @relation(fields: [storeId], references: [id])
  createdById   Int
  createdBy     User         @relation(fields: [createdById], references: [id])
  totalAmount   Float
  customerName  String?
  customerPhone String?
  customerGstin String?
  // "CASH" | "UPI" | "CARD" | "CREDIT" | "OTHER". Null on every bill rung up
  // in the app, which does not ask — it exists because the offline sheets
  // being imported record how each day's takings were collected, and that is
  // the one thing about them the ledger cannot re-derive.
  paymentMethod String?
  createdAt     DateTime     @default(now())
  // Set only for sales generated by settling a Consignment (see
  // Settlement below) — null for legacy sales entered before the
  // consignment model existed, or any hand-entered sale.
  consignmentId Int?
  consignment   Consignment? @relation(fields: [consignmentId], references: [id])

  lines      SaleLine[]
  settlement Settlement?

  // Every dashboard load asks four questions about one day's sales, for every
  // sales person, every five minutes. Without this each one reads the whole
  // sales history to find them.
  @@index([date])
}

// type: "SALE" | "RETURN". A RETURN line credits its quantity back to stock
// instead of deducting it, and its amount is subtracted from the sale's
// totalAmount instead of added — this is what lets one bill cover both a
// sale and a same-visit return/exchange. reason mirrors Return.reason and
// is only set when type = "RETURN".
model SaleLine {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  amount    Float
  type      String  @default("SALE")
  reason    String?

  // Postgres does not index a foreign key on its own, and every chart and
  // every sheet of the Excel export reads sale lines through their sale
  // ("the lines of every bill in this date range"). Without this that is a
  // scan of every line ever recorded, each time.
  @@index([saleId])
}

// reason: "CUSTOMER_RETURN" | "DAMAGED" | "EXCHANGE" | "OTHER" | "CONSIGNMENT_UNSOLD"
// An audit ledger row, written automatically whenever a Sale is created with
// a RETURN-type line (see SaleLine.type) — one row per returned product.
// Also written directly (reason "CONSIGNMENT_UNSOLD") when a Consignment is
// settled with unsold stock — see the /consignments/:id/settle route, which
// writes these without going through POST /returns (that endpoint's
// processReturn() credits stock back into the store, which is the wrong
// direction for stock leaving the store back to HQ).
model Return {
  id          Int      @id @default(autoincrement())
  date        DateTime
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  reason      String
  reference   String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  // Set only for CONSIGNMENT_UNSOLD rows, so editing a settlement can find
  // and replace exactly the rows it created (reference alone isn't unique
  // enough — the same consignment can be settled in more than one pass).
  settlementId Int?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
}

// End-of-shift wastage: what a salesperson counts as spoiled at the end of
// their run, one row per product they counted.
//
// THIS IS NOT DailyStockEntry.wastage, AND THE TWO MUST NEVER BE ADDED
// TOGETHER. They measure different stock at different points in its life:
//
//   DailyStockEntry.wastage  stock that spoiled while sitting in a STORE.
//                            Per (date, store, product), decrements that
//                            store's ledger, and is what the Reports wastage
//                            chart, the Excel Wastage Breakdown sheet and the
//                            P&L cost line are built from (lib/analytics.js).
//
//   Wastage (this table)     stock that spoiled back at HQ, counted at the end
//                            of a shift. It has no storeId because it has no
//                            store: unsold consignment stock has already come
//                            back to HQ as a CONSIGNMENT_UNSOLD Return by the
//                            time anyone counts it, so there is no store
//                            ledger left to decrement and no store to blame.
//
// Deliberately storeless, and deliberately outside the stock ledger: the app
// tracks stock in stores, not stock at HQ, so there is nothing here to
// decrement. That also means there is no "available quantity" to validate a
// count against — see the route, which caps nothing on purpose.
//
// reason: "SPOILED" | "DAMAGED" | "EXPIRED" | "OTHER" — unlike the ledger
// counter, a per-entry row CAN carry a reason, which is most of why this
// table earns its place.
model Wastage {
  id          Int      @id @default(autoincrement())
  date        DateTime
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  reason      String
  // Who counted it. An end-of-shift count belongs to a person — two people
  // counting on the same day would otherwise merge into one figure with no
  // way to tell whose it was. Same rule as every other record here.
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date])
}

// The sale-or-return model this business runs on: HQ delivers stock to a
// store (this record, status DELIVERED) but doesn't recognize revenue or
// charge GST until the store reports what actually sold — see Settlement.
// status: "DELIVERED" | "PARTIAL_SETTLED" | "SETTLED" | "RETURNED"
// (RETURNED is a fully-settled consignment where nothing sold at all.)
model Consignment {
  id            Int      @id @default(autoincrement())
  consignmentNo String   @unique
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  createdById   Int
  createdBy     User     @relation(fields: [createdById], references: [id])
  status        String   @default("DELIVERED")
  deliveredAt   DateTime
  settledAt     DateTime?
  notes         String?
  createdAt     DateTime @default(now())

  items       ConsignmentItem[]
  settlements Settlement[]
  sales       Sale[]
}

// soldQty/returnedQty are cumulative totals across every Settlement made
// against this consignment (a consignment can be settled in more than one
// pass — see SettlementLine for the per-event breakdown). Never exceeds
// deliveredQty; enforced in the /consignments/:id/settle route.
model ConsignmentItem {
  id            Int         @id @default(autoincrement())
  consignmentId Int
  consignment   Consignment @relation(fields: [consignmentId], references: [id])
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  deliveredQty  Int
  soldQty       Int         @default(0)
  returnedQty   Int         @default(0)
  pricePerUnit  Float
  // deliveredQty * pricePerUnit — the consignment's face value, not revenue.
  // Revenue is only recognized on the Sale a Settlement generates.
  totalValue    Float

  settlementLines SettlementLine[]
}

// One row per settlement action/visit — a Consignment can be settled in
// multiple passes over multiple days, so this is the audit trail of each
// one, not a mutable summary. saleId is set only if this settlement had
// any sold quantity (it generates exactly one Sale covering everything
// sold in this pass); a settlement that was 100% unsold has no Sale.
model Settlement {
  id            Int         @id @default(autoincrement())
  settlementNo  String      @unique
  consignmentId Int
  consignment   Consignment @relation(fields: [consignmentId], references: [id])
  createdById   Int
  createdBy     User        @relation(fields: [createdById], references: [id])
  settledAt     DateTime
  notes         String?
  saleId        Int?        @unique
  sale          Sale?       @relation(fields: [saleId], references: [id])
  createdAt     DateTime    @default(now())

  lines   SettlementLine[]
  returns Return[]
}

// soldQty/returnedQty here are what was settled in THIS pass only (not
// cumulative — see ConsignmentItem for the running totals).
model SettlementLine {
  id                Int             @id @default(autoincrement())
  settlementId      Int
  settlement        Settlement      @relation(fields: [settlementId], references: [id])
  consignmentItemId Int
  consignmentItem   ConsignmentItem @relation(fields: [consignmentItemId], references: [id])
  soldQty           Int             @default(0)
  returnedQty       Int             @default(0)
}

// Map loads drawn and geocoding requests answered this month, against the
// Mapbox free tier. One row per calendar month in UTC ("2026-08") — see
// src/lib/mapUsage.js for why this is counted here rather than read back from
// Mapbox.
model MapUsage {
  month    String @id
  loads    Int    @default(0)
  geocodes Int    @default(0)
}

// One planned cell of the 30-day channel calendar: day 1-30, one of three
// times of day. Ninety rows, seeded once from whatsapp/strategy/30-day.json.
//
// Deliberately separate from WhatsAppPost. That table is history — what the
// generator actually wrote, when, for whom, with a rating against it. This one
// is a plan: it exists before anything is written and most of its rows will sit
// empty of prose for weeks. Merging them would mean every history query had to
// filter out ninety rows of intent, and the plan would be rewritten every time
// somebody pressed Generate.
//
// draft is the short version written by hand in the strategy file and is never
// empty. fullPost is what the generator produced from that draft and is null
// until somebody asks for it — the calendar is usable, and free, before any of
// them exist.
model WhatsAppContent {
  id                 Int       @id @default(autoincrement())
  day                Int // 1-30, a position in the plan rather than a calendar date
  timeSlot           String // "morning" | "afternoon" | "night"
  theme              String
  engagementQuestion String?
  imageIdea          String?
  draft              String
  fullPost           String?
  // Planned is not sent, the same distinction WhatsAppPost.used draws. Only
  // these two fields are written by the dashboard; everything above comes from
  // the seed and is left alone.
  sent               Boolean   @default(false)
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // The seed is run more than once — after an edit to the strategy file, and on
  // every fresh database. This is what lets it upsert instead of duplicating,
  // and it is also the calendar's natural sort.
  @@unique([day, timeSlot])
  @@index([sent])
}

// ---------------------------------------------------------------------------
// Team chat — one room, the whole staff in it.
//
// A WhatsApp group, not a support system: no threads, no channels, no
// reactions. Everybody reads and writes; only Admins add people, remove people
// and delete messages.
// ---------------------------------------------------------------------------

model TeamChatMessage {
  id        Int      @id @default(autoincrement())
  // Nullable, because a system announcement has no author. Attributing one to
  // whichever Admin happened to have the lowest id would put words in a real
  // person's mouth in a room their whole team reads.
  senderId  Int?
  sender    User?    @relation("ChatSender", fields: [senderId], references: [id], onDelete: SetNull)
  body      String

  // Posted by the app, not a person. Rendered as a notice across the thread
  // rather than as a message bubble, and never deletable from the UI.
  isSystem  Boolean  @default(false)

  // Pinned messages are shown above the thread. A boolean rather than a
  // separate table: there is one room, and "pinned" is a property of the
  // message in it.
  isPinned  Boolean  @default(false)

  // Deleted, not gone. WhatsApp leaves "This message was deleted" in the
  // thread, and so does this: a message vanishing without trace makes the
  // conversation above and below it stop making sense, and there is no way to
  // tell a moderation from a bug afterwards. Who did it is recorded.
  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?    @relation("ChatDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Set when the author rewrites a message. The thread marks it "edited", the
  // way every chat app does — a message that changes silently after people have
  // read it is worse than one that was never sent.
  editedAt  DateTime?

  // The thread is read newest-last and polled with "anything after id N", so
  // both of those are index lookups rather than scans.
  @@index([createdAt])
  @@index([isPinned])
}

model TeamChatMember {
  id       Int      @id @default(autoincrement())
  // One row per person: a user is either in the room or not. The unique
  // constraint is what makes "add" idempotent — re-adding someone who left
  // reactivates their row instead of creating a second one and doubling them
  // in the member list.
  userId   Int      @unique
  user     User     @relation("ChatMember", fields: [userId], references: [id], onDelete: Cascade)

  addedById Int?
  addedBy   User?    @relation("ChatAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())
  leftAt   DateTime?

  // The unread badge, in one column.
  //
  // The alternative — a row per message per member — is a row count that grows
  // with traffic times headcount, and turns the badge into a NOT IN over a
  // growing table on every poll. This is a single indexed count of messages
  // newer than a timestamp, and one write when somebody opens the room.
  //
  // What it cannot do is say who read which message. If "seen by" ticks are
  // ever wanted, that is the point to add a receipts table — not before.
  lastReadAt DateTime?

  @@index([isActive])
}

// A shop that has approached us, or that we want to approach.
//
// Separate from Store on purpose: a Store is somewhere we already trade, with
// stock and settlements hanging off it. A lead is a candidate, and most of them
// never become one. Merging the two would put rows with no stock, no sales and
// no settlement terms into every store query in the app.
//
// Almost everything is nullable because a lead arrives however it arrives — a
// name and a phone number scribbled down at a market is a real lead, and a
// table that refuses it just moves the lead to somebody's notebook.
model RetailerLead {
  id     Int    @id @default(autoincrement())
  name   String
  // How they came to us: WALK_IN, REFERRAL, FIELD_VISIT, INBOUND_CALL, OTHER.
  // A plain string rather than an enum — the list of ways a shop reaches a
  // small distributor changes faster than a migration can keep up with.
  source String @default("OTHER")
  status String @default("NEW")

  contactName String?
  phone       String?
  email       String?

  address   String?
  // Same shape as Store, and for the same reason: the address is for people,
  // these are for the distance maths. Without them a lead cannot be scored on
  // location at all, which is most of what decides whether it is worth a visit.
  lat       Float?
  lng       Float?
  accuracyM Float?

  // What the field rep observed. Self-reported and rough — used as a weak
  // signal with the weight to match, never as a measurement.
  monthlyFootfall Int?
  shelfSpaceCm    Int?

  notes String?

  // Cached from the last scoring run so a list can be ordered without
  // recomputing every row. Null means never scored; the score is only ever a
  // snapshot of the network as it stood at scoredAt.
  score    Float?
  scoredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById Int?
  createdBy   User? @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([score])
}
