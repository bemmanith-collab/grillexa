DATABASE_URL="postgresql://user:password@localhost:5432/grillexa"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
ZENQUOTES_KEY=""
# Mapbox. Both optional: with neither set the map picker still searches and
# reverse geocodes through Nominatim, it just cannot draw a map.
#   MAPBOX_ACCESS_TOKEN is the secret `sk.` token used for geocoding on the
#   server. It never reaches a browser.
#   MAPBOX_PUBLIC_TOKEN is the `pk.` token the page uses to draw the map. It is
#   public by design — restrict it by URL in the Mapbox dashboard.
MAPBOX_ACCESS_TOKEN=""
MAPBOX_PUBLIC_TOKEN=""
