DATABASE_URL="postgresql://user:password@localhost:5432/grillexa"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
ZENQUOTES_KEY=""
# Mapbox. Both optional: with neither set the map picker still searches and
# reverse geocodes through Nominatim, it just cannot draw a map.
#   MAPBOX_ACCESS_TOKEN is the secret `sk.` token used for geocoding on the
#   server. It never reaches a browser.
#   MAPBOX_PUBLIC_TOKEN is the `pk.` token the page uses to draw the map. It is
#   public by design — restrict it by URL in the Mapbox dashboard.
MAPBOX_ACCESS_TOKEN=""
MAPBOX_PUBLIC_TOKEN=""
# The city that bare store addresses ("MG Road", "Whitefield") are resolved
# against when a store with no pin gets one in the background after a bill.
# UNSET MEANS OFF, which is the safe default: those names exist in several
# Indian cities, and guessing put three of six stores in the wrong one.
STORE_GEOCODE_CITY=""
# How long to wait on a geocoder before giving up on that attempt. The HTTP
# calls abort themselves at 8s regardless; this only shortens the waiting.
STORE_GEOCODE_TIMEOUT_MS=2000
# Who is told when a store gets located. ONE email address, and strictly nobody
# else — these carry where staff were when they billed. FAILS CLOSED: unset
# means nobody is notified, never "notify everyone". Successes only, and the
# push expires after 24h so a phone that was off all weekend gets nothing.
GEO_NOTIFY_EMAIL=""

# Widest GPS reading still allowed to become a pin (metres). Default 5.
STORE_PIN_MAX_ACCURACY_M=""

# How far a geocoded point may sit from the nearest trusted pin (km). Default 2.
STORE_GEOCODE_MAX_KM=""
