# Copy this file to .env and fill in what you want to use. .env is gitignored.
#
# Three providers can write the posts. The first one configured wins, in this
# order: Gemini, then Claude, then Pollinations.

# ---------------------------------------------------------------------------
# 1. Google Gemini — free, and the recommended choice
# ---------------------------------------------------------------------------
# A key takes a minute and needs no card: https://aistudio.google.com/apikey
# The free tier limits requests per minute and per day, which is plenty for a
# post a day and enough for the occasional --batch run.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# 2. Anthropic Claude — the best writing, and the only one that costs money
# ---------------------------------------------------------------------------
# Roughly ₹5 a post. Used only if it is set and GEMINI_API_KEY is not.
# Key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# CLAUDE_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# 3. Pollinations — free, no key, no promises
# ---------------------------------------------------------------------------
# The last resort, used when nothing else is configured. It is an anonymous
# relay in front of somebody else's models: no quota you control, no uptime
# guarantee, and it will sometimes ignore parts of the brand format. Read what
# it writes before posting it.
#
# On by default. Set this to false to turn it off, so a missing key fails
# loudly instead of quietly producing a worse post.
# POLLINATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# Override the choice
# ---------------------------------------------------------------------------
# Force one provider regardless of what else is configured: gemini, claude or
# pollinations. Errors if the one you name is not set up, rather than falling
# back — a post from an unexpected provider is worse than no post, because
# nobody looks twice at it.
# AI_PROVIDER=gemini
